# ==============================================================================
# GauShilp OS - Environment Configuration Template
# Copy this file to .env and provide appropriate values.
# NEVER commit .env to source control!
# ==============================================================================

# Core Application Settings
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database (PostgreSQL) - Required from Step 2
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gaushilp_db?schema=public

# Authentication (OIDC / JWT Provider Integration - Step 3)
# Provider-independent integration boundary. Configure when auth provider is selected.
AUTH_PROVIDER=oidc
AUTH_ISSUER_URL=https://auth.example.com/
AUTH_AUDIENCE=gaushilp-api
AUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json

# Fallback / Internal Token Settings
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars_long
JWT_EXPIRES_IN=1d

# Redis & Distributed Caching (Step 13)
# When REDIS_URL is provided, the API uses Redis with tenant-scoped keys and pattern invalidation.
# When omitted or if Redis becomes unreachable, the app automatically falls back to PostgreSQL (or in-memory in dev).
REDIS_URL=redis://localhost:6379
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=300

# Cloudflare R2 / Object Storage Integration (Step 11)
# Options: 'sandbox' (default for testing/dev), 'r2' (Cloudflare R2 / S3-compatible)
OBJECT_STORAGE_PROVIDER=sandbox
OBJECT_STORAGE_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=gaushilp-media
OBJECT_STORAGE_ACCESS_KEY_ID=your_r2_access_key_id
OBJECT_STORAGE_SECRET_ACCESS_KEY=your_r2_secret_access_key
PUBLIC_ASSETS_BASE_URL=https://media.gaushilp.example.com
STORAGE_UPLOAD_URL_EXPIRATION_SECONDS=900
STORAGE_DOWNLOAD_URL_EXPIRATION_SECONDS=300

# Customer-to-Seller Payments Integration (Step 8)
# Options: 'sandbox' (default), 'razorpay', 'stripe'
PAYMENT_PROVIDER=sandbox
PAYMENT_API_KEY=sandbox_payment_key
PAYMENT_API_SECRET=sandbox_payment_secret
PAYMENT_WEBHOOK_SECRET=sandbox_payment_webhook_secret

# Seller-to-GauShilp SaaS Subscriptions Integration (Step 8)
# Options: 'sandbox' (default), 'razorpay', 'stripe'
SUBSCRIPTION_PROVIDER=sandbox
SUBSCRIPTION_API_KEY=sandbox_subscription_key
SUBSCRIPTION_API_SECRET=sandbox_subscription_secret
SUBSCRIPTION_WEBHOOK_SECRET=sandbox_subscription_webhook_secret

# Shipping and Fulfilment Integration (Step 9)
# Options: 'sandbox' (default), 'delhivery', 'shiprocket', 'bluedart', 'indiapost'
SHIPPING_PROVIDER=sandbox
SHIPPING_API_KEY=sandbox_shipping_key
SHIPPING_API_SECRET=sandbox_shipping_secret
SHIPPING_WEBHOOK_SECRET=sandbox_shipping_webhook_secret

# Notifications & Background Jobs Integration (Step 10)
# Options: 'sandbox' (default), 'sendgrid', 'resend', 'ses'
EMAIL_PROVIDER=sandbox
EMAIL_API_KEY=sandbox_email_key
EMAIL_FROM=notifications@gaushilp.com
EMAIL_FROM_NAME=GauShilp OS
QUEUE_MAX_RETRIES=5
QUEUE_BACKOFF_DELAY_MS=1000
# ==============================================================================
# Daily PostgreSQL Backups & Disaster Recovery (Step 14)
# ==============================================================================
# Storage Provider for Backups: 'sandbox' (in-memory for testing/local), 's3' (AWS S3 / Cloudflare R2 isolated bucket)
BACKUP_STORAGE_PROVIDER=sandbox
# Dedicated, isolated backup bucket - MUST be separate from primary media/assets storage!
BACKUP_STORAGE_BUCKET=gaushilp-backups-isolated
BACKUP_STORAGE_ENDPOINT=https://your_backup_account_id.r2.cloudflarestorage.com
BACKUP_STORAGE_REGION=auto
# Dedicated credentials with write/read privileges strictly scoped to the backup bucket
BACKUP_STORAGE_ACCESS_KEY_ID=your_isolated_backup_access_key
BACKUP_STORAGE_SECRET_ACCESS_KEY=your_isolated_backup_secret_key
# 256-bit AES envelope encryption key (Hex or string, at least 32 characters)
BACKUP_ENCRYPTION_KEY=replace_with_a_secure_256_bit_encryption_key_at_least_32_chars
# Retention period for automated daily backups in days (default: 30)
BACKUP_RETENTION_DAYS=30
# Cron schedule for daily backups (default: 0 2 * * * = 02:00 UTC daily)
BACKUP_SCHEDULE_CRON="0 2 * * *"
# Operator email address for immediate alerts upon backup failure or corruption
BACKUP_ALERT_EMAIL=devops-alerts@gaushilp.com


